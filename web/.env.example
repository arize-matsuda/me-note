# このファイルをコピーして .env.local を作り、値を書く:
#   cp .env.example .env.local
# .env.local はコミットされない（.gitignore で除外）。値をこのファイルやチャットに書かないこと。

# Neon の開発用ブランチ（dev）の接続文字列
# Neon の管理画面 → dev ブランチ → Connect で表示されるもの
DATABASE_URL=

# Better Auth
# ランダムな秘密の値。次のコマンドで作る: openssl rand -base64 32
BETTER_AUTH_SECRET=
# アプリの URL（手元では http://localhost:3000）
BETTER_AUTH_URL=
